# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Model Configuration
OPENAI_MODEL=gpt-4o-mini

# Provider Selection (openai, ollama, elevenlabs, local_tts, flux, etc.)
AI_PROVIDER_SCRIPT=openai
AI_PROVIDER_IMAGE=openai
AI_PROVIDER_VOICE=elevenlabs

# Local/Alternative Provider Settings
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3

FLUX_API_URL=http://flux:8000

LOCAL_TTS_URL=http://tts:5002

# Resource Management
# Set to 'true' to unload models after use (saves VRAM for single GPU setups)
SINGLE_GPU_MODE=true
