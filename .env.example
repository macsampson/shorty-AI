# API Keys - Required
OPENAI_API_KEY=your_openai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Model Configuration - Optional
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=gemma3:27b

# Provider Selection
AI_PROVIDER_SCRIPT=ollama
AI_PROVIDER_IMAGE=flux
AI_PROVIDER_VOICE=local_tts

# Native Service URLs (localhost for non-Docker setup)
OLLAMA_BASE_URL=http://localhost:11434
FLUX_API_URL=http://localhost:8008
LOCAL_TTS_URL=http://localhost:5002
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_OUTPUT_DIR=O:/dev/ComfyUI/output

# Resource Management
SINGLE_GPU_MODE=true

# Pipeline Mode
PIPELINE_MODE=shorty
